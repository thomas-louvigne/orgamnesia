{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orgamnesia",
  "version": "0.9.0",
  "identifier": "com.orgamnesia.app",
  "build": {
    "beforeDevCommand": "trunk serve --port 1420",
    "beforeBuildCommand": "trunk build --release",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orgamnesia",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "publisher": "Thomas L",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "longDescription": "Personal wiki made of org-mode files, with links between pages, backlinks, #tag keywords, split panes and configurable (Classic or Emacs) keybindings.",
    "shortDescription": "A personal wiki in org-mode files: a lite Obsidian with an Emacs flavour",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "editors"
      }
    }
  }
}
