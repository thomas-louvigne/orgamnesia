{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Org Wiki Flow",
  "version": "0.1.0",
  "identifier": "com.org-wiki-flow.app",
  "build": {
    "beforeDevCommand": "trunk serve --port 1420",
    "beforeBuildCommand": "trunk build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Org Wiki Flow",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
